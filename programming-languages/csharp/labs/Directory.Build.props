<Project>
  <!-- File-based apps default to Native AOT. That pulls in the ILCompiler package, whose NuGet audit
       warning has nothing to do with the labs, and trimming analysis, which warns on ordinary reflection.
       The labs run on the JIT, like a normal console app. -->
  <PropertyGroup>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
</Project>
